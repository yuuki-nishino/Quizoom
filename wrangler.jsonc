{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quizoom",
  "compatibility_date": "2025-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server/index.ts",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quizoom-db",
      "database_id": "4d0a0c42-04aa-43f0-b1ca-d37b40c6a967",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "quizoom-media"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "QUIZ_SESSION",
        "class_name": "QuizSessionDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["QuizSessionDO"]
    }
  ]
}
