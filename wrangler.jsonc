{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quizoom",
  "account_id": "7ce2d4c56b6d2496c1e6eb39dee1729a",
  "compatibility_date": "2025-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server/index.ts",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // run_worker_first を付けないと、ブラウザの通常のページ遷移に見えるリクエスト
    // (Sec-Fetch-Dest: document 等)は SPA フォールバックがエッジで横取りしてしまい、
    // /api/auth/callback/google のような Worker 側で処理すべきAPIルートに一切届かない。
    // 実際、GoogleのOAuthコールバックがこれによってワーカーへ到達せず、
    // ログインが完全に失敗する不具合が本番で発生した
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quizoom-db",
      "database_id": "4d0a0c42-04aa-43f0-b1ca-d37b40c6a967",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "quizoom-media"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "QUIZ_SESSION",
        "class_name": "QuizSessionDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["QuizSessionDO"]
    }
  ]
}
